# -----------------------------------------------------------------------------
# ECOMMERCE PLATFORM - Compose variable overrides
# Copy to .env (gitignored) and adjust. Every variable below has a safe default
# in docker-compose.yml, so this file is optional.
# -----------------------------------------------------------------------------

# Shared Postgres credentials (matches infra/postgres/init).
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
# Internal hostname of the Postgres service on the compose network.
POSTGRES_HOST=postgres

# user-service JWT signing key (HS256 requires >= 32 bytes) and token lifetime.
APP_JWT_SECRET=change-me-to-a-32-byte-min-secret-key-for-hs256!!-dev-only
APP_JWT_EXPIRATION_MS=28800000
